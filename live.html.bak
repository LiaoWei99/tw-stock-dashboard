<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#07111e"><link rel="manifest" href="/manifest.webmanifest"><title>台股波段・隔日沖作戰台 V5</title><style>
:root{--bg:#07111e;--card:#102237;--line:#29435e;--text:#edf5fc;--muted:#91a8be;--red:#ff6878;--green:#48d39f;--blue:#55aaff;--gold:#f4c75d}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Noto Sans TC",sans-serif}.wrap{max-width:1500px;margin:auto;padding:22px}.top{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap}.brand{font-size:25px;font-weight:900}.muted,.note{color:var(--muted)}.note{font-size:12px}.tabs{display:flex;gap:8px;overflow:auto;margin:18px 0}.tab,button{border:1px solid var(--line);background:#0c1b2c;color:#c9daea;padding:10px 14px;border-radius:10px;cursor:pointer}.tab.on,button.primary{background:#2475b8;color:#fff}.section{display:none}.section.on{display:block}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:12px}.card{grid-column:span 4;background:linear-gradient(180deg,#122840,#0d1d2f);border:1px solid var(--line);border-radius:16px;padding:15px}.wide{grid-column:span 8}.full{grid-column:span 12}.half{grid-column:span 6}h3{margin:0 0 10px;font-size:15px}.big{font-size:28px;font-weight:900}.up{color:var(--red)}.dn{color:var(--green)}.gold{color:var(--gold)}.controls{display:flex;gap:8px;flex-wrap:wrap}.controls input{flex:1;min-width:240px;background:#081522;color:#fff;border:1px solid var(--line);padding:11px;border-radius:9px}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:13px}th,td{padding:9px;border-bottom:1px solid #20384f;text-align:right;white-space:nowrap}th:first-child,td:first-child{text-align:left}.pill{display:inline-block;padding:4px 7px;border-radius:20px;background:#17304a;font-size:11px}.news a{color:#d9eaff;text-decoration:none}.news{padding:8px 0;border-bottom:1px solid #20384f}.status{padding:5px 8px;background:#17304a;border-radius:8px;font-size:12px}.warn{border-left:3px solid var(--gold);padding-left:10px}.score{font-weight:900;color:#9ed1ff}@media(max-width:850px){.card,.wide,.half{grid-column:span 12}.wrap{padding:14px}.brand{font-size:21px}}
</style></head><body><div class="wrap"><div class="top"><div><div class="brand">台股波段・隔日沖作戰台 <span class="pill">V5</span></div><div class="muted">盤前情報 → 資金輪動 → 隔日延續 → 波段趨勢 → 個股事件</div></div><div><span id="apiStatus" class="status">資料更新中</span> <button class="primary" onclick="refreshAll()">全部更新</button> <span id="clock" class="muted"></span></div></div>
<div class="tabs"><button class="tab on" data-s="dash">總覽</button><button class="tab" data-s="overnight">隔日沖</button><button class="tab" data-s="swing">波段</button><button class="tab" data-s="flow">資金輪動</button><button class="tab" data-s="intel">國際情報</button><button class="tab" data-s="search">個股搜尋</button></div>
<section id="dash" class="section on"><div class="grid"><div class="card"><h3>市場廣度</h3><div id="breadth" class="big">讀取中</div><div id="breadthSub" class="note"></div></div><div class="card"><h3>隔日延續 LSO</h3><div id="lso" class="big gold">計算中</div><div id="lsoSub" class="note"></div></div><div class="card"><h3>資料狀態</h3><div id="dataMode" class="big">TWSE</div><div class="note">公開資料版：波段/隔日沖。沒有授權期貨 feed 時不偽造盤中期貨數字。</div></div><div class="card full"><h3>今日成交值 Top 20</h3><div class="tablewrap"><table><thead><tr><th>股票</th><th>收/現價</th><th>漲跌%</th><th>成交值(億)</th><th>成交量</th><th>收盤位置</th></tr></thead><tbody id="topRows"></tbody></table></div></div></div></section>
<section id="overnight" class="section"><div class="grid"><div class="card full"><h3>隔日沖候選池</h3><div class="note warn">以成交值、漲跌幅、收盤接近高點等可驗證欄位評分；法人/即時期貨等未接資料不納入分數。</div><div class="tablewrap"><table><thead><tr><th>股票</th><th>價格</th><th>漲跌%</th><th>成交值(億)</th><th>收盤位置</th><th>可用資料分數</th><th>狀態</th></tr></thead><tbody id="overnightRows"></tbody></table></div></div></div></section>
<section id="swing" class="section"><div class="grid"><div class="card full"><h3>波段觀察池</h3><div class="note warn">目前為量價/流動性初篩。20日/60日趨勢、法人與財報接通後才會升級為完整波段模型。</div><div class="tablewrap"><table><thead><tr><th>股票</th><th>價格</th><th>漲跌%</th><th>成交值(億)</th><th>日內區間位置</th><th>初篩分數</th><th>判讀</th></tr></thead><tbody id="swingRows"></tbody></table></div></div></div></section>
<section id="flow" class="section"><div class="grid"><div class="card half"><h3>強勢成交值個股</h3><div id="strongFlow">讀取中</div></div><div class="card half"><h3>弱勢成交值個股</h3><div id="weakFlow">讀取中</div></div><div class="card full"><h3>期貨資料狀態</h3><div id="futures">讀取中</div></div></div></section>
<section id="intel" class="section"><div class="grid"><div class="card full"><h3>可能影響台股的國際新聞</h3><div class="note">5 分鐘自動更新。新聞相關性不等於已證實造成股價漲跌。</div><div id="globalNews">讀取中</div></div></div></section>
<section id="search" class="section"><div class="grid"><div class="card full"><h3>個股搜尋＋產業＋新聞</h3><div class="controls"><input id="stockSearch" placeholder="輸入代號、名稱或產業，例如 2330 / 台積電 / 半導體"><button class="primary" onclick="searchStock()">搜尋</button></div><div id="stockInfo" style="margin-top:14px" class="note">搜尋後顯示官方公司資料與可能相關新聞。</div></div><div class="card full"><h3>可能影響新聞</h3><div id="stockNews">—</div></div></div></section>
<div class="note" style="margin-top:18px">資料原則：TWSE MIS / TWSE OpenAPI / TAIFEX 官方資料與新聞聚合。Unknown/Unavailable 不參與評分。網站是研究與篩選工具，不自動下單。</div></div><script>
const $=s=>document.querySelector(s), esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));let market=[];
function pos(x){let r=x.high-x.low;return r>0?Math.max(0,Math.min(100,(x.close-x.low)/r*100)):50}function money(v){return (v/1e8).toFixed(1)}
function score(x,kind){let s=0,p=pos(x);s+=Math.min(35,Math.log10(Math.max(x.value,1))/10*35);if(x.pct>0)s+=Math.min(30,x.pct*5);if(p>70)s+=25;else if(p>50)s+=12;if(kind==='swing'&&x.pct>7)s-=8;return Math.max(0,Math.min(100,Math.round(s)))}
function renderMarket(rows){market=rows;let up=rows.filter(x=>x.pct>0).length,dn=rows.filter(x=>x.pct<0).length;$('#breadth').innerHTML=`<span class="up">${up}</span> / <span class="dn">${dn}</span>`;$('#breadthSub').textContent='Top資料集上漲 / 下跌；全市場廣度以後端資料集為準';$('#topRows').innerHTML=rows.slice(0,20).map(x=>`<tr><td><b>${esc(x.code)} ${esc(x.name)}</b></td><td>${x.close||'—'}</td><td class="${x.pct>=0?'up':'dn'}">${x.pct.toFixed(2)}%</td><td>${money(x.value)}</td><td>${Math.round(x.volume/1000).toLocaleString()}張</td><td>${pos(x).toFixed(0)}%</td></tr>`).join('');let o=[...rows].filter(x=>x.value>0).sort((a,b)=>score(b,'overnight')-score(a,'overnight')).slice(0,20);$('#overnightRows').innerHTML=o.map(x=>`<tr><td><b>${esc(x.code)} ${esc(x.name)}</b></td><td>${x.close}</td><td class="${x.pct>=0?'up':'dn'}">${x.pct.toFixed(2)}%</td><td>${money(x.value)}</td><td>${pos(x).toFixed(0)}%</td><td class="score">${score(x,'overnight')}</td><td>${score(x,'overnight')>=70?'優先觀察':score(x,'overnight')>=55?'觀察':'不列主攻'}</td></tr>`).join('');let sw=[...rows].sort((a,b)=>score(b,'swing')-score(a,'swing')).slice(0,20);$('#swingRows').innerHTML=sw.map(x=>`<tr><td><b>${esc(x.code)} ${esc(x.name)}</b></td><td>${x.close}</td><td class="${x.pct>=0?'up':'dn'}">${x.pct.toFixed(2)}%</td><td>${money(x.value)}</td><td>${pos(x).toFixed(0)}%</td><td class="score">${score(x,'swing')}</td><td>${score(x,'swing')>=65?'量價偏強':'待趨勢確認'}</td></tr>`).join('');let strong=rows.filter(x=>x.pct>0).slice(0,10),weak=rows.filter(x=>x.pct<0).slice(0,10);$('#strongFlow').innerHTML=strong.map(x=>`<div>${esc(x.code)} ${esc(x.name)} <span class="up">${x.pct.toFixed(2)}%</span>｜${money(x.value)}億</div>`).join('')||'—';$('#weakFlow').innerHTML=weak.map(x=>`<div>${esc(x.code)} ${esc(x.name)} <span class="dn">${x.pct.toFixed(2)}%</span>｜${money(x.value)}億</div>`).join('')||'—';let avg=o.slice(0,10).reduce((a,x)=>a+score(x,'overnight'),0)/Math.max(1,o.slice(0,10).length);$('#lso').textContent=avg>=70?'偏強續航':avg>=55?'中性偏多':'保守';$('#lsoSub').textContent=`可用資料 LSO ${avg.toFixed(0)}/100；缺少法人/授權期貨時不納入。`;}
async function loadMarket(){try{let r=await fetch('/api/market/top?limit=50&all=1',{cache:'no-store'}),j=await r.json();if(!j.ok)throw 0;renderMarket(j.rows);$('#apiStatus').textContent='TWSE 官方資料 '+new Date().toLocaleTimeString();}catch(e){$('#apiStatus').textContent='市場資料 Unavailable'}}
function newsHtml(rows){return rows.map(x=>{let cls=x.sentiment==='偏多'?'up':x.sentiment==='偏空'?'dn':'gold';let tag=x.sentiment?`<span class="pill ${cls}">${esc(x.sentiment)}</span> `:'';return `<div class="news">${tag}<a href="${esc(x.url)}" target="_blank" rel="noopener"><b>${esc(x.title)}</b></a><div class="note">${esc(x.source)}｜${esc(x.published)}</div>${x.sentiment_reason?`<div class="note">判斷：${esc(x.sentiment_reason)}</div>`:''}</div>`}).join('')||'沒有資料'}
async function loadNews(){try{let j=await (await fetch('/api/news/global',{cache:'no-store'})).json();$('#globalNews').innerHTML=j.ok?newsHtml(j.rows):'Unavailable'}catch(e){$('#globalNews').textContent='Unavailable'}}
async function loadFutures(){try{let j=await (await fetch('/api/futures/ranking',{cache:'no-store'})).json();$('#futures').innerHTML=j.mode==='licensed-realtime'?'已接授權即時期貨行情源':`<span class="gold">即時期貨排行未接授權 feed</span><div class="note">${esc(j.note||'')}</div>`}catch(e){$('#futures').textContent='Unavailable'}}
async function searchStock(){let q=$('#stockSearch').value.trim();if(!q)return;$('#stockInfo').textContent='搜尋中…';$('#stockNews').textContent='搜尋中…';try{let j=await (await fetch('/api/company/search?q='+encodeURIComponent(q),{cache:'no-store'})).json();if(!j.ok||!j.rows.length){$('#stockInfo').textContent='查無股票資料；請確認代號或名稱。';$('#stockNews').textContent='—';return}if(j.rows.length>1&&!q.match(/^\d+$/)){let opts=j.rows.slice(0,12).map(x=>`<button onclick="loadStock('${esc(x.code)}')">${esc(x.code)} ${esc(x.name)}｜${esc(x.market)}｜${esc(x.industry||'')}</button>`).join(' ');$('#stockInfo').innerHTML=`找到多筆結果，請選擇：<div class="controls" style="margin-top:10px">${opts}</div>`;$('#stockNews').textContent='選擇個股後載入新聞';return}await loadStock(j.rows[0].code)}catch(e){$('#stockInfo').textContent='Unavailable';$('#stockNews').textContent='Unavailable'}}
async function loadStock(code){$('#stockInfo').textContent='載入最新行情…';$('#stockNews').textContent='載入可能影響新聞…';try{let c=await (await fetch('/api/stock/context?code='+encodeURIComponent(code),{cache:'no-store'})).json();if(!c.ok)throw 0;let x=c.company,q=c.quote;let quote=q?`<div style="margin-top:8px"><b>最新價格 ${q.price??'—'}</b>｜今日漲跌 <span class="${(q.pct??0)>=0?'up':'dn'}">${q.change>=0?'+':''}${q.change??'—'} / ${q.pct!=null?(q.pct>=0?'+':'')+q.pct.toFixed(2)+'%':'—'}</span></div><div>開 ${q.open??'—'}｜高 ${q.high??'—'}｜低 ${q.low??'—'}｜成交量 ${q.volume?Number(q.volume).toLocaleString():'—'}</div><div class="note">行情來源：${esc(q.source)}｜資料時間 ${esc(q.date)} ${esc(q.time)}</div>`:`<div class="gold">最新行情 Unavailable</div>`;$('#stockInfo').innerHTML=`<div class="big">${esc(x.code)} ${esc(x.name)}</div><div>${esc(x.market)}｜產業：${esc(x.industry||'Unknown')}</div>${x.business?`<div>核心業務：${esc(x.business)}</div>`:''}${quote}`;let n=await (await fetch('/api/news/stock?code='+encodeURIComponent(x.code)+'&name='+encodeURIComponent(x.name)+'&industry='+encodeURIComponent(x.industry||''),{cache:'no-store'})).json();$('#stockNews').innerHTML=n.ok?`<div class="note warn">偏多/偏空為新聞標題與事件詞初判，不等於股價預測；無法可靠判斷時標示「中性／待確認」。</div>${newsHtml(n.rows)}`:'Unavailable'}catch(e){$('#stockInfo').textContent='Unavailable';$('#stockNews').textContent='Unavailable'}}
async function refreshAll(){await Promise.all([loadMarket(),loadNews(),loadFutures()])}document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tab,.section').forEach(x=>x.classList.remove('on'));b.classList.add('on');$('#'+b.dataset.s).classList.add('on')});setInterval(()=>$('#clock').textContent=new Date().toLocaleString('zh-TW'),1000);refreshAll();setInterval(loadMarket,60000);setInterval(loadNews,300000);setInterval(loadFutures,60000);
</script></body></html>
